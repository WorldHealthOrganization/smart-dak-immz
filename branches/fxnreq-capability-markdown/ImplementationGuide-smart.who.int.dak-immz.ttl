       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Define parameters for report" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (I) report generation:\nActivity: Define parameters for report:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to schedule routine reports (specific date/time, daily, weekly, etc.)\n\nso that\n\n>The reports can be generated automatically and are available at the right time" ] ;
