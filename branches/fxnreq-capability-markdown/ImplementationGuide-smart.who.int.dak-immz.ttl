       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Requirements/IMMZ.FXNREQ.011.A> ;
         fhir:Reference.reference [ fhir:value "Requirements/IMMZ.FXNREQ.011.A" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Verify information for additional data" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (A) vaccination location registration:\nActivity: Verify information for additional data:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to verify all required vaccination location information is complete\n\nso that\n\n>Any missed fields can be identified" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
