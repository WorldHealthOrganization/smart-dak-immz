       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Update/add new vaccination location" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (A) vaccination location registration:\nActivity: Update/add new vaccination location:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to send a notification to the NMFL about a new vaccination location added to EIR\n\nso that\n\n>The NMFL can be aware of any potentially new vaccination locations" ] ;
