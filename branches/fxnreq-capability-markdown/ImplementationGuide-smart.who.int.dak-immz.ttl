         fhir:Reference.reference [ fhir:value "Requirements/IMMZ.FXNREQ.010.A" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Verify information for additional data" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (A) vaccination location registration:\nActivity: Verify information for additional data:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to automatically identify changes in vaccination locations information, retrieved from other interconnected systems, and prompt for validation\n\nso that\n\n>I will know what changes are being made and can validate them" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
