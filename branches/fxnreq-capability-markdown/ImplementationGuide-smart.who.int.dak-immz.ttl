       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/implementationguide-resource-format" ] ;
         fhir:Extension.valueCode [ fhir:value "application/fhir+json" ]
       ], [
         fhir:index 1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Binary" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Binary/LM.IMMZ.FXNREQ.002.A> ;
         fhir:Reference.reference [ fhir:value "Binary/LM.IMMZ.FXNREQ.002.A" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "LM.IMMZ.FXNREQ.002.A" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (A) vaccination location registration:\nActivity: Validate against national master facility list:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to interface with National Master Facility List (NMFL) database to validate the EIR master list of vaccination locations\n\nso that\n\n>I can ensure the lists are synchronized" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
