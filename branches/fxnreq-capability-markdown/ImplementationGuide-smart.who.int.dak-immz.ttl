       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Update vaccination event records" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (H) resolve duplicate vaccination events:\nActivity: Update vaccination event records:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to be able to provide history of merged event records\n\nso that\n\n>I can double check if the merge was done appropriately" ] ;
