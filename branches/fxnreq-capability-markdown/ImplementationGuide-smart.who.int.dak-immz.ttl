       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Determine if vaccines were missed" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (F) defaulter tracing:\nActivity: Determine if vaccines were missed:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To specify thresholds for a client to qualify as requiring follow-up, based on the national immunization guidelines\n\nso that\n\n>Follow up is only done at the appropriate time" ] ;
