       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Evaluate vaccine event records" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (H) resolve duplicate vaccination events:\nActivity: Evaluate vaccine event records:\nAs a <a href=\"ActorDefinition-eirstafforhealthworker.html\">EIR staff OR health worker</a>, I want to:\n>To be able to view simultaneously potential duplicate records\n\nso that\n\n>I can easily compare the records and to determine if they are duplicates" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
