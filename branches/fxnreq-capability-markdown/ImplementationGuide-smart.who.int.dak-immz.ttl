       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Verify information for additional data" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (A) vaccination location registration:\nActivity: Verify information for additional data:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to generate report of missing information\n\nso that\n\n>Missing information can be obtained" ] ;
