       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Create client record" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) client registration:\nActivity: Create client record:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>The system to uniquely identify every client using a system generated unique identifier or an existing identifier (e.g. health care, national ID, health unique ID)\n\nso that\n\n>The client can be definitively identified using that number" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
