         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Binary" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Binary/LM.IMMZ.FXNREQ.003.A> ;
         fhir:Reference.reference [ fhir:value "Binary/LM.IMMZ.FXNREQ.003.A" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "LM.IMMZ.FXNREQ.003.A" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (A) vaccination location registration:\nActivity: Validate against national master facility list:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to flag any vaccination location registered in the EIR that is not on the NMFL\n\nso that\n\n>I can identify vaccination locations that need further investigation" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
