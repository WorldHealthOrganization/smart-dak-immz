       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (D) administer vaccine:\nActivity: Determine required vaccination(s):\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>The system to display vaccines due according to predefined vaccine protocol\n\nso that\n\n>I can assess which vaccines need to be administered" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
