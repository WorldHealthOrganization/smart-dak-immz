       fhir:ImplementationGuide.definition.resource.name [ fhir:value "The EIR system to be able to communicate with other systems (such as a national health management information system [HMIS] and Expanded Programme on Immunization [EPI]) to obtain vaccination locations information and other necessary information" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "As a <a href=\"ActorDefinition-electronicimmunizationregistryeirstaff.html\">Electronic immunization registry (EIR) staff</a>, I want:\n>The EIR system to be able to communicate with other systems (such as a national health management information system [HMIS] and Expanded Programme on Immunization [EPI]) to obtain vaccination locations information and other necessary information\n\nso that\n\n>I will know about new vaccination locations and be informed about any updated information" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
