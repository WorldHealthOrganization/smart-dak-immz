       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Update record to document reason/lost follow-up" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (F) defaulter tracing:\nActivity: Update record to document reason/lost follow-up:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To flag when there is a change of address and a new client has been added to another catchment area\n\nso that\n\n>The client will appear on the correct list for follow up" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
