       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Validate against national master facility list" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (A) vaccination location registration:\nActivity: Validate against national master facility list:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>The system to be able to link a vaccination location’s NMFL identification (ID) with the corresponding EIR identifier\n\nso that\n\n>There will be a common understanding of what vaccination location is being referenced" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
