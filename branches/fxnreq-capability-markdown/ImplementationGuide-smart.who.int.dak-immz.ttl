       fhir:ImplementationGuide.definition.resource.name [ fhir:value "The notification to include specific details about upcoming immunization session dates and times or outreach dates and times as appropriate" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "As a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want:\n>The notification to include specific details about upcoming immunization session dates and times or outreach dates and times as appropriate\n\nso that\n\n>The client will know specifically when and where to go to receive a vaccination" ] ;
