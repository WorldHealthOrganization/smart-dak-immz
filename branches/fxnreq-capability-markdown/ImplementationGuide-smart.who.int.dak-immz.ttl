       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (E) client reminder:\nActivity: Define/evaluate criteria:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To associate a client with a vaccination location to generate a provider-based reminder/recall\n\nso that\n\n>Vaccination location specific lists of clients can be generated" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
