       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Validate client details" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) client registration:\nActivity: Validate client details:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>The ability to generate a barcode label to affix to the paper record\n\nso that\n\n>The record can easily be uniquely identified by scanning the ID" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 666 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Requirements/IMMZ.FXNREQ.056.C> ;
         fhir:Reference.reference [ fhir:value "Requirements/IMMZ.FXNREQ.056.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Validate client details" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) client registration:\nActivity: Validate client details:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>The ability to associate a unique ID generated by another authority (local or global) to the record\n\nso that\n\n>The record can be more easily shared or identified with other appropriate systems" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 667 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Requirements/IMMZ.FXNREQ.057.C> ;
         fhir:Reference.reference [ fhir:value "Requirements/IMMZ.FXNREQ.057.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Validate client details" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) client registration:\nActivity: Validate client details:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>The system to display the information of the selected record\n\nso that\n\n>I can validate and update (if needed) client information" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 668 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Requirements/IMMZ.FXNREQ.058.C> ;
         fhir:Reference.reference [ fhir:value "Requirements/IMMZ.FXNREQ.058.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Validate client details" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) client registration:\nActivity: Validate client details:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>To be able to modify appropriate client data as needed\n\nso that\n\n>the record contains up to date information" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 669 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Requirements/IMMZ.FXNREQ.059.C> ;
         fhir:Reference.reference [ fhir:value "Requirements/IMMZ.FXNREQ.059.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Validate client details" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) client registration:\nActivity: Validate client details:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>The system to track that I have changed an existing record\n\nso that\n\n>accountability for data modification is ensured" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
