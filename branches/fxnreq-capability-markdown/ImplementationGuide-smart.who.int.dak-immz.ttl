       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Identify groups of vaccination events for evaluation" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (H) resolve duplicate vaccination events:\nActivity: Identify groups of vaccination events for evaluation:\nAs a <a href=\"ActorDefinition-eirstaff.html\">EIR staff</a>, I want to:\n>to be able to modify the business rules used for identifying vaccination events duplicates\n\nso that\n\n>The de-duplication process can be optimized" ] ;
