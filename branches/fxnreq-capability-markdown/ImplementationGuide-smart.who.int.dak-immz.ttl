       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "Requirements" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <http://smart.who.int/dak-immz/Requirements/IMMZ.FXNREQ.060.C> ;
         fhir:Reference.reference [ fhir:value "Requirements/IMMZ.FXNREQ.060.C" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "Validate client details" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "*Business process* (C) client registration:\nActivity: Validate client details:\nAs a <a href=\"ActorDefinition-healthworker.html\">Health worker</a>, I want to:\n>The system to identify changes made to the record for my confirmation before saving\n\nso that\n\n>I can have the opportunity to double check the data to prevent entry errors" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
